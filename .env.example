PORT=3000
DATABASE_URL=YOUR_SUPABASE_CONNECTION_STRING
DATABASE_SSL=true
JWT_SECRET=YOUR_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=1h

# Restrict new registrations (and, when configured, logins) to this owner email.
AUREX_OWNER_EMAIL=owner@example.com

# Optional cloud AI. If unset or unavailable, Aurex attempts the paired local Ollama fallback.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
AUREX_MODEL=gpt-6-luna
